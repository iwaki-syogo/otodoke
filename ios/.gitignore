# Real settings (Supabase URL, anon key). Copy Config/Secrets.xcconfig.example and fill it in locally.
/Config/Secrets.xcconfig

# Crypto test vectors written by scripts/ios-fixtures.ts (`npm run ios:fixtures`): never committed.
/OtodokeTests/Fixtures/crypto/

# Generated by `xcodegen generate` from project.yml
/Otodoke/Support/Info.plist

# The generated project is not committed, except the package pins inside it.
# Git cannot re-include a file under an ignored directory, so each level is opened one by one.
/Otodoke.xcodeproj/*
!/Otodoke.xcodeproj/project.xcworkspace/
/Otodoke.xcodeproj/project.xcworkspace/*
!/Otodoke.xcodeproj/project.xcworkspace/xcshareddata/
/Otodoke.xcodeproj/project.xcworkspace/xcshareddata/*
!/Otodoke.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/Otodoke.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Otodoke.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Build output and per-user state
build/
DerivedData/
.build/
xcuserdata/
*.xcarchive
*.ipa
*.dSYM*
ExportOptions.plist
