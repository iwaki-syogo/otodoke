# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets (never commit)
.secrets/
secrets/
.credentials/
*.p8
*.key
!.env.example

# real (non-anonymized) emails live here only on the author's machine
/fixtures/raw/
AuthKey_*

# Full anonymized set stays local; only the curated fixtures/demo is public
/fixtures/anonymized/
__pycache__/
.vitest/
