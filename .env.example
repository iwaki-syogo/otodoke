# Copy this file to the local env file Next.js reads (.env.local) and fill in. Never commit that file.
# Claude API (Anthropic Console, personal org)
ANTHROPIC_API_KEY=
# Supabase (project "otodoke")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Resend: inbound (email.received webhook) + magic-link SMTP
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Domain that receives forwarded order emails, e.g. in.otodoke.app
INBOUND_DOMAIN=
# Public URL of this app, e.g. https://otodoke-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3015
