# Copy this file to the local env file Next.js reads (.env.local) and fill in. Never commit that file.
# Claude API (Anthropic Console, personal org)
ANTHROPIC_API_KEY=
# Supabase (project "otodoke")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Resend. RESEND_API_KEY and RESEND_WEBHOOK_SECRET are for receiving mail (email.received webhook).
# Sending the sign-up confirmation and password reset mails (Supabase Auth SMTP) uses RESEND_SMTP_KEY below.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Sending-only key for Supabase Auth SMTP (read by `supabase config push`, not by the app)
RESEND_SMTP_KEY=
# Domain that receives forwarded order emails, e.g. in.otodoke.app
INBOUND_DOMAIN=
# Public URL of this app, e.g. https://otodoke.app
NEXT_PUBLIC_APP_URL=http://localhost:3015
# Optional: paid Claude calls per JST day
OTODOKE_USER_DAILY_LIMIT=30
OTODOKE_GLOBAL_DAILY_LIMIT=300
OTODOKE_UNREAD_USER_MAIL_LIMIT=
OTODOKE_UNREAD_GLOBAL_MAIL_LIMIT=
OTODOKE_UNREAD_USER_BYTE_LIMIT=
OTODOKE_UNREAD_GLOBAL_BYTE_LIMIT=
